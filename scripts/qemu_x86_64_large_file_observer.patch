+static bool bv_native_stop(CPUState *cpu, RunState state)
+{
+    BvStop stop = {0};
+    unsigned i;
+    uint64_t physical, slot, gen, op;
+    unsigned char opcode;
+    int result;
+    if (bv_control.state == BV_CTL_DISABLED) { return false; }
+    if (bv_timing_enabled) { bv_notify_us = g_get_monotonic_time(); }
+    bv_calibration_pause = false;
+    if (cpu != bv_cpu || state != RUN_STATE_DEBUG ||
+        bv_scheduled || !bv_cpu_state(&stop.cpu)) {
+        bv_abort();
+    }
+    if (bv_control.state == BV_CTL_ARMED) {
+        for (i = 0; i < bv_control.site_count && stop.cpu.rip != bv_control.sites[i]; ++i) {}
+        if (i == bv_control.site_count) { return false; } /* Existing GDB lifecycle/fault hook. */
+        if (cpu->watchpoint_hit || cpu->singlestep_enabled) { bv_abort(); }
+        if (bv_breakpoint_count(stop.cpu.rip) != 1 ||
+            !bv_read_word(bv_slot, &slot, 4) || slot >= 8 ||
+            !bv_read_word(bv_tasks + slot*4096 + 8, &gen, 8) ||
+            !gen || gen >= UINT64_C(0x80000000) ||
+            !bv_read_word(bv_syscall, &op, 8)) {
+            bv_abort();
+        }
+        /* CREATE controls live hooks; console acknowledgements drive the
+         * bounded feeder. Their source/return must remain synchronous in GDB. */
+        if (i < 2) {
+            bv_live_generation[slot] = (op == 132 || op == 15 || op == 20) ?
+                                       gen : 0;
+        }
+        if (bv_control.site_count == 5 && i >= 3 &&
+            !bv_start_known(&bv_start_ack, (unsigned)slot, gen)) {
+            if (i == 3 && !bv_start_offer(&bv_start_ack, (unsigned)slot, gen)) {
+                bv_abort();
+            }
+            return false;
+        }
+        if (bv_live_generation[slot] == gen) { return false; }
+        if (bv_control.site_count == 5) {
+            int handoff = bv_replay_yield(&bv_replay_handoff, bv_control.events);
+            if (handoff < 0) { bv_abort(); }
+            /* Existing source breakpoint owns its normal GDB callback/RET.
+             * No record is dropped, and no in-flight target is abandoned. */
+            if (handoff) { return false; }
+        }
+        if (bv_control.events < bv_calibration_limit) { bv_calibration_sites |= 1u << i; }
+        if (!bv_read_word(stop.cpu.rsp, &stop.target, 8) ||
+            !bv_bound(stop.cpu.rip, 1, &stop.binding[0]) ||
+            !bv_bound(stop.target, 1, &stop.binding[1]) ||
+            !bv_bound(stop.cpu.rsp, 8, &stop.binding[2]) ||
+            !bv_ram_read(NULL, stop.binding[0], &opcode, 1)) {
+            bv_abort();
+        }
+        stop.ret_opcode = opcode;
+    } else if (bv_control.state == BV_CTL_WAIT) {
+        if (cpu->watchpoint_hit || cpu->singlestep_enabled) { bv_abort(); }
+        stop.target = bv_control.before.target;
+        stop.ret_opcode = bv_control.before.ret_opcode;
+        for (i = 0; i < 3; ++i) {
+            uint64_t address = i == 0 ? bv_control.before.cpu.rip :
+                               i == 1 ? stop.target : bv_control.before.cpu.rsp;
+            if (!bv_bound(address, i == 2 ? 8 : 1, &physical)) { bv_abort(); }
+            stop.binding[i] = physical;
+        }
+        if (bv_breakpoint_count(stop.cpu.rip) != 1 ||
+            !bv_ram_read(NULL, stop.binding[0], &opcode, 1) ||
+            opcode != stop.ret_opcode) {
+            bv_abort();
+        }
+    } else {
+        bv_abort();
+    }
+    stop.actual_breakpoint = 1;
+    result = bv_control_stop(&bv_control, &stop, &bv_ops, NULL);
+    if (result != 1) { bv_abort(); }
+    if (bv_timing_enabled) { bv_finished_us = g_get_monotonic_time(); }
+    return !bv_calibration_pause;
+}
