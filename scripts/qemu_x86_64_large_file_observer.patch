+    BvCPU cpu;
+    (void)user_ctx;
+    if (bv_control.state == BV_CTL_DISABLED) { gdb_put_packet("E22"); return; }
+    if (bv_control.site_count != 5 || bv_control.state != BV_CTL_ARMED ||
+        bv_scheduled || runstate_is_running() || !runstate_check(RUN_STATE_DEBUG) ||
+        params->len != 1 || !bv_start_ack.pending || !bv_cpu_state(&cpu) ||
+        cpu.rip != bv_control.sites[3] || (cpu.reg[15] & 512)) { bv_abort(); }
+    p = gdb_get_cmd_param(params, 0)->data;
+    if (!bv_hex(&p, ';', &version) || version != 1 ||
+        !bv_hex(&p, ';', &slot) || slot >= 8 || !bv_hex(&p, 0, &gen) || *p ||
+        !bv_read_word(bv_slot, &actual_slot, 4) || actual_slot != slot ||
+        !bv_read_word(bv_tasks+slot*4096, &state, 8) || state != 2 ||
+        !bv_read_word(bv_tasks+slot*4096+8, &actual_gen, 8) || actual_gen != gen ||
+        !bv_start_acknowledge(&bv_start_ack, (unsigned)slot, gen)) { bv_abort(); }
+    gdb_put_packet("OK");
+}
