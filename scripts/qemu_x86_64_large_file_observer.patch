+static inline int bv_trace_write(BvSnapshot *s, BvWrite write, void *p,
+                                 const unsigned char *data, size_t n,
+                                 uint32_t *crc)
+{
+    if (s->failed || n > BV_TRACE_LIMIT - s->written ||
+        !write(p, data, n)) { s->failed = 1; return 0; }
+    s->written += n;
+    if (crc) { *crc = bv_crc(*crc, data, n); }
+    return 1;
+}
+static inline int bv_snapshot_init(BvSnapshot *s, const BvRange *ranges,
+                                   unsigned count, unsigned char *shadow,
+                                   size_t capacity, BvWrite write, void *p)
+{
+    unsigned i, pages = 0;
+    uint64_t end = 0, a, n;
+    unsigned char wire[16 + 32 * 16];
+    if (!s || s->failed || s->initialized || s->written || !ranges ||
+        !count || count > 32 || !shadow || !write || s->sparse > 1 || s->extended > 1 || (s->extended && !s->sparse)) { return 0; }
+    for (i = 0; i < count; ++i) {
+        a = ranges[i].physical; n = ranges[i].pages;
+        if (!n || n > BV_TRACE_PAGES - pages || (a & 4095) ||
+            a < end || a > UINT64_MAX - n * 4096 ||
+            !((a >= 0x100000 && a + n*4096 <= 0x8000000) ||
+              (a >= UINT64_C(0x100000000) &&
+               a + n*4096 <= UINT64_C(0x400000000)))) { return 0; }
+        end = a + n*4096; pages += (unsigned)n;
+    }
+    if (capacity < (size_t)pages * 4096) { return 0; }
+    memcpy(s->ranges, ranges, count * sizeof(*ranges));
+    s->count = count; s->pages = pages; s->shadow = shadow;
+    s->sequence = 1; s->phase = 0;
+    memcpy(wire, s->extended ? "RBVT5\0\0\0" : s->sparse ? "RBVT4\0\0\0" : "RBVT3\0\0\0", 8);
+    bv_le(wire + 8, count, 4); bv_le(wire + 12, pages, 4);
+    for (i = 0; i < count; ++i) {
+        bv_le(wire + 16 + i*16, ranges[i].physical, 8);
+        bv_le(wire + 24 + i*16, ranges[i].pages, 8);
+    }
+    return bv_trace_write(s, write, p, wire, 16 + count*16, NULL);
+}
+typedef const unsigned char *(*BvView)(void *, uint64_t, size_t);
+static inline int bv_snapshot_record_view(BvSnapshot *s, unsigned phase,
+                                     uint64_t sequence, const BvStop *stop,
+                                     BvRead read, BvView view, BvWrite write, void *p)
+{
+    unsigned char wire[232], buffer[4096], descriptor[16], trailer[32];
+    const unsigned char *page;
+    uint32_t crc = UINT32_MAX;
+    uint64_t a, mask;
+    unsigned i, j, bit, end, index = 0, changed = 0;
+    unsigned full_ram = phase == 0 || sequence <= (s->extended ? 160 : 32);
+    if (!s || s->failed) { return 0; }
+    if (!s->written || !stop || (!read && !view) || !write || sequence != s->sequence ||
+        !sequence || sequence > 262144 || phase != s->phase || phase > 1) {
+        s->failed = 1; return 0;
+    }
+    memcpy(wire, s->extended ? "RBVF5\0\0\0" : s->sparse ? "RBVF4\0\0\0" : "RBVF3\0\0\0", 8);
+    bv_le(wire + 8, sequence, 8); bv_le(wire + 16, phase, 8);
+    bv_le(wire + 24, stop->cpu.rip, 8); bv_le(wire + 32, stop->cpu.rsp, 8);
+    for (i = 0; i < 17; ++i) { bv_le(wire + 40 + i*8, stop->cpu.reg[i], 8); }
+    bv_le(wire + 176, stop->target, 8);
+    for (i = 0; i < 3; ++i) { bv_le(wire + 184 + i*8, stop->binding[i], 8); }
+    bv_le(wire + 208, stop->actual_breakpoint, 8);
+    bv_le(wire + 216, stop->ret_opcode, 8);
+    bv_le(wire + 224, full_ram, 8);
+    if (!bv_trace_write(s, write, p, wire, sizeof(wire), &crc)) { return 0; }
+    if (full_ram && s->sparse) {
+        if ((s->pages & 7) && (s->selected[s->pages/8] >> (s->pages & 7))) {
+            s->failed = 1; return 0;
+        }
+        if (!bv_trace_write(s, write, p, s->selected, (s->pages+7)/8, &crc)) {
+            return 0;
+        }
+    }
+    for (i = 0; full_ram && i < s->count; ++i) {
+        for (j = 0; j < s->ranges[i].pages; ++j, ++index) {
+            unsigned fresh = s->sparse ?
+                !(s->seen[index/8] & (1u << (index&7))) : !s->initialized;
+            if (s->sparse && !(s->selected[index/8] & (1u << (index&7)))) {
+                continue;
+            }
+            a = s->ranges[i].physical + (uint64_t)j*4096;
+            if (view) {
+                page = view(p, a, 4096);
+                if (!page) { s->failed = 1; return 0; }
+            } else {
+                if (!read(p, a, buffer, 4096)) { s->failed = 1; return 0; }
+                page = buffer;
+            }
+            if (fresh || memcmp(page, s->shadow + index*4096, 4096)) {
+                mask = fresh ? UINT64_MAX : 0;
+                if (!fresh) {
+                    for (bit = 0; bit < 64; ++bit) {
+                        if (memcmp(page + bit*64, s->shadow + index*4096 + bit*64, 64)) {
+                            mask |= UINT64_C(1) << bit;
+                        }
+                    }
+                }
+                bv_le(descriptor, a, 8); bv_le(descriptor + 8, mask, 8);
+                if (!mask || !bv_trace_write(s, write, p, descriptor, 16, &crc)) {
+                    s->failed = 1; return 0;
+                }
+                for (bit = 0; bit < 64; bit = end) {
+                    end = bit + 1;
+                    if (!(mask & (UINT64_C(1) << bit))) { continue; }
+                    while (end < 64 && (mask & (UINT64_C(1) << end))) { ++end; }
+                    if (!bv_trace_write(s, write, p, page + bit*64,
+                                        (end - bit)*64, &crc)) { return 0; }
+                }
+                memcpy(s->shadow + index*4096, page, 4096);
+                ++changed;
+                s->seen[index/8] |= 1u << (index&7);
+            }
+        }
+    }
+    bv_le(trailer, UINT64_MAX, 8);
+    bv_le(trailer + 8, sequence, 8); bv_le(trailer + 16, phase, 8);
+    bv_le(trailer + 24, changed, 4);
+    crc = bv_crc(crc, trailer, 28);
+    bv_le(trailer + 28, crc ^ UINT32_MAX, 4);
+    if (!bv_trace_write(s, write, p, trailer, sizeof(trailer), NULL)) { return 0; }
+    s->initialized = 1; s->phase ^= 1;
+    if (!s->phase) { ++s->sequence; }
+    return 1;
+}
+static inline int bv_snapshot_record(BvSnapshot *s, unsigned phase,
+                                     uint64_t sequence, const BvStop *stop,
+                                     BvRead read, BvWrite write, void *p)
+{
+    return bv_snapshot_record_view(s, phase, sequence, stop, read, NULL, write, p);
+}
