+    bv_continue_bh = qemu_bh_new(bv_resume_bottom_half, NULL);
+    bv_snapshot.sparse = 1; bv_snapshot.extended = site_count == 5;
+    if (!bv_snapshot_init(&bv_snapshot, ranges, 2,
