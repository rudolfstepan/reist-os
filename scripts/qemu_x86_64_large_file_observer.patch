+static bool bv_bound(uint64_t address, size_t size, uint64_t *physical)
+{
+    MemTxAttrs attrs;
+    hwaddr translated;
+    if (!bv_physical(address, size, physical) ||
+        (address & 4095) + size > 4096) {
+        return false;
+    }
+    translated = cpu_get_phys_page_attrs_debug(bv_cpu, address, &attrs);
