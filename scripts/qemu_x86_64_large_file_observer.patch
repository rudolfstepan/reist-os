+{
+    hwaddr offset, available = size;
+    MemoryRegion *region;
+    (void)opaque;
+    RCU_READ_LOCK_GUARD();
+    region = address_space_translate(&address_space_memory, physical, &offset,
+                                     &available, false, MEMTXATTRS_UNSPECIFIED);
