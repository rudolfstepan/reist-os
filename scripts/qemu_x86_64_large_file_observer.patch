+static bool bv_cpu_state(BvCPU *cpu)
+{
+    static const unsigned indices[19] =
+        {16, 7, 0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15, 17, 29};
+    uint64_t values[19];
+    unsigned i, size;
+    cpu_synchronize_state(bv_cpu);
+    for (i = 0; i < 19; ++i) {
+        g_byte_array_set_size(bv_register, 0);
+        size = gdb_read_register(bv_cpu, bv_register, indices[i]);
+        if (size != (i == 17 ? 4 : 8) || bv_register->len != size) {
+            return false;
+        }
+        values[i] = size == 8 ? ldq_le_p(bv_register->data) :
+                               ldl_le_p(bv_register->data);
+    }
+    cpu->rip = values[0]; cpu->rsp = values[1];
+    memcpy(cpu->reg, values + 2, sizeof(cpu->reg));
+    return true;
