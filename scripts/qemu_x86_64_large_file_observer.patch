+        fflush(bv_trace) ||
+        !bv_control_arm_count(&bv_control, sites, targets, site_count, 1, bv_clock(NULL)+(site_count == 5 ? 600000 : 300000),
+                         &bv_ops, NULL)) {
+        bv_abort();
+    }
+    bv_timing_enabled = g_strcmp0(g_getenv("REIST_BV_TIMING"), "1") == 0;
+    gdb_put_packet("OK");
+}
