+            !memory_region_is_ram(region) || memory_region_is_ram_device(region) ||
+            offset > memory_region_size(region) ||
+            pins[i].bytes > memory_region_size(region) - offset) { return 0; }
+        pins[i].ram = (unsigned char *)memory_region_get_ram_ptr(region) + offset;
