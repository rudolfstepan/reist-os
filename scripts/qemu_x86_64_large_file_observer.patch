+    if (count != 1 || !gdbserver_state.c_cpu) { gdb_put_packet("E22"); return; }
+    p = gdb_get_cmd_param(params, 0)->data;
+    if (!bv_hex(&p, ';', &v[0]) || (v[0] != 1 && v[0] != 2)) {
+        gdb_put_packet("E22"); return;
+    }
